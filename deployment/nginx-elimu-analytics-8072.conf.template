# New HTTPS server block for port 8072; do not modify existing elimu.moe.go.tz :443 vhosts.
# Replace BOTH certificate paths using valid paths from THIS analytics server.
# Add only after verifying port 8072 free and host Nginx loads conf.d/*.conf.
server {
    listen 8072 ssl;
    server_name elimu.moe.go.tz;

    ssl_certificate /REPLACE/WITH/ELIMU/fullchain.pem;
    ssl_certificate_key /REPLACE/WITH/ELIMU/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;

    access_log /var/log/nginx/kobo-analytics-8072.access.log;
    error_log /var/log/nginx/kobo-analytics-8072.error.log warn;

    client_max_body_size 1m;

    # Prefer an IP allowlist/VPN for the leader's account after validating its egress IP.
    # For example: allow APPROVED_IP/32; deny all; (do not copy placeholders into active config).
    location / {
        proxy_pass http://127.0.0.1:5080;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port 8072;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 90s;
        proxy_send_timeout 90s;
    }
}
