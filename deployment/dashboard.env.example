# Install at /etc/kobo-school-analytics/dashboard.env with 0600 root:root.
# Kobo collection remains on a separate production server and is accessed by HTTPS only.
KOBO_BASE_URL=https://kpi.esmis.moe.go.tz
KOBO_ASSET_UID=aStHVYV5gmRm6Jt7yLGgzs
KOBO_API_TOKEN=REPLACE_WITH_DEDICATED_READ_ONLY_TOKEN
DASHBOARD_USER=internal_dashboard_admin
DASHBOARD_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
# Optional per-form read-only tokens: useful if surveys have different owners.
# Empty values fall back to KOBO_API_TOKEN.
KOBO_TOKEN_TATHMINI=
KOBO_TOKEN_UTHIBITI=
KOBO_TOKEN_MWALIMU=
KOBO_TOKEN_PICHA=
# Optional only if a Kobo REST Service is explicitly enabled later.
KOBO_WEBHOOK_TOKEN=
HOST=127.0.0.1
PORT=18072
POLL_SECONDS=300
MAX_SUBMISSIONS=10000
